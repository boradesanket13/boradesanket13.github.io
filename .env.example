# Optional. Fine-grained GitHub PAT (public read access is enough) used to
# fetch your PINNED repositories via GraphQL. Without this, the site falls
# back to showing all your repos grouped into tabs by primary language.
# Create one at https://github.com/settings/tokens
GITHUB_TOKEN=



# Optional. If set, skips scraping youtube.com/@handle to resolve the
# channel ID and uses this directly. Find your channel ID at
# https://www.youtube.com/@boradesanket13 -> "..." menu -> "Share channel".
YOUTUBE_CHANNEL_ID=

# Optional. Overrides data/header.json's stats.leetcodeUsername for the
# LeetCode rating/badge stat. No auth needed either way — this just lets
# you set it via env instead of committing it to the JSON.
LEETCODE_USERNAME=
